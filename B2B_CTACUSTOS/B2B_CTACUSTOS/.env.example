# Caminho manual opcional. Quando preenchido, tem prioridade sobre a busca.
# EXCEL_PATH=C:\Dados\B2B_CTACUSTOS.xlsx
EXCEL_PATH=

# Com EXCEL_PATH vazio, a busca é feita pelo nome do arquivo nas pastas
# OneDrive pessoais/corporativas sincronizadas no Windows.
EXCEL_FILENAME=B2B_CTACUSTOS.xlsx
# Compatibilidade: versões antigas usavam EXCEL_FILE_NAME. Não é necessário
# manter as duas variáveis; EXCEL_FILENAME é o nome atual recomendado.
EXCEL_SHEET_NAME=Atividades

# Opcional: restrinja a pesquisa a uma ou mais bibliotecas sincronizadas.
# No Windows, separe vários diretórios por ponto e vírgula. Deixe vazio para
# detectar automaticamente os OneDrives do usuário, sem nome fixo de usuário.
EXCEL_SEARCH_ROOTS=

# Mantém a base incluída em data/ como fallback para demonstração. Em produção,
# use false para exigir que o arquivo compartilhado seja localizado.
EXCEL_FALLBACK_SAMPLE=true

# Pasta opcional para as planilhas auxiliares de Serviços e Materiais.
# Vazio = cria B2B_CTACUSTOS_Importacoes ao lado do Excel principal.
REFERENCE_UPLOAD_DIR=

# Bases da calculadora. Com os caminhos vazios, o aplicativo procura primeiro
# ao lado do Excel principal e depois nos OneDrives sincronizados.
SERVICES_EXCEL_PATH=
SERVICES_EXCEL_FILENAME=SERVICOS.xlsx
SERVICES_EXCEL_SHEET_NAME=SERVICOS
MATERIALS_EXCEL_PATH=
MATERIALS_EXCEL_FILENAME=MATERIAL.xlsx
# Vazio aceita automaticamente a única aba existente no arquivo de materiais.
MATERIALS_EXCEL_SHEET_NAME=

# Acesso à página Configurações. Altere a senha antes de distribuir o app.
ADMIN_USERNAME=ADMIN
ADMIN_PASSWORD=CTAB2BADMIN*

APP_HOST=127.0.0.1
APP_PORT=8765
